---
import type { Profile } from "../data/site";

interface Props {
  name: string;
  profile: Profile;
  location: string;
}

const { name, profile, location } = Astro.props;
---
<section id="about" class="hero" aria-labelledby="intro-title">
  <div class="hero__inner">
    <div class="hero__copy">
      <h1 id="intro-title">{name}</h1>
      <p class="hero__role">{profile.role}</p>
      <p class="hero__intro">{profile.intro}</p>
      <div class="hero__actions" aria-label="Primary links">
        <a class="hero__email" href={`mailto:${profile.email}`}>Email<span aria-hidden="true"> ↗</span></a>
        <a href={profile.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
        <a href={profile.resumePath}>Résumé</a>
      </div>
    </div>

    <dl class="hero__metadata" aria-label="Education summary">
      {profile.metadata.map((item) => (
        <div>
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))}
    </dl>

    <div class="hero__aside">
      <figure class="hero__portrait-frame">
        <picture>
          <source
            type="image/webp"
            srcset="/headphoto-160.webp 160w, /headphoto-320.webp 320w, /headphoto-640.webp 640w, /headphoto-800.webp 800w"
            sizes="(max-width: 38.75em) max(7rem, 40vw), (max-width: 53.75em) 14rem, 17rem"
          />
          <img
            class="hero__portrait"
            src={profile.photoPath}
            alt={`${name} portrait`}
            width="640"
            height="480"
            fetchpriority="high"
          />
        </picture>
        <figcaption>{location}</figcaption>
      </figure>
    </div>

    <nav class="hero__directory" aria-label="Explore my work">
      <a href="#research" aria-labelledby="directory-research" aria-describedby="directory-research-detail">
        <span class="hero__directory-text"><strong id="directory-research">Research</strong><span id="directory-research-detail">Adaptive storage &amp; SQL evaluation</span></span>
        <span aria-hidden="true">↘</span>
      </a>
      <a href="#code" aria-labelledby="directory-code" aria-describedby="directory-code-detail">
        <span class="hero__directory-text"><strong id="directory-code">Public code</strong><span id="directory-code-detail">Python pipelines &amp; tools for coding agents</span></span>
        <span aria-hidden="true">↘</span>
      </a>
      <a href="#experience" aria-labelledby="directory-experience" aria-describedby="directory-experience-detail">
        <span class="hero__directory-text"><strong id="directory-experience">Experience</strong><span id="directory-experience-detail">AI workflows, backend services &amp; teaching</span></span>
        <span aria-hidden="true">↘</span>
      </a>
    </nav>
  </div>
</section>
