---
import type { OtherWorkItem } from "../data/site";

interface Props {
  items: OtherWorkItem[];
}

const { items } = Astro.props;
---
<ol class="other-work-list">
  {items.map((item) => (
    <li>
      <article>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
        <div class="other-work-list__links">
          {item.links.map((link) => (
            <a class="text-link" href={link.href} target="_blank" rel="noreferrer">
              {link.label}<span aria-hidden="true"> ↗</span>
            </a>
          ))}
        </div>
      </article>
    </li>
  ))}
</ol>
