---
import type { PublicProject } from "../data/site";

interface Props {
  projects: PublicProject[];
}

const { projects } = Astro.props;
---
<div class="public-code">
  <p class="public-code__intro">Try the example, read the documentation, or explore the source.</p>
  <ul class="project-list">
    {projects.map((project) => (
      <li>
        <article id={project.name} class="project-row">
          <div class="project-row__body">
            <span class="project-row__language">{project.language}</span>
            <h3><a class="work-title-link" href={`#${project.name}`} title={`Link to ${project.name}`}>{project.name}<span class="work-title-link__mark" aria-hidden="true">#</span></a></h3>
            <p>{project.description}</p>
          </div>
          <div class="project-example">
            {project.preview.kind === "code" ? (
              <>
                <div class="project-example__header">
                  <p class="project-example__label">{project.preview.label}</p>
                  <button class="project-example__copy" type="button" hidden>Copy code</button>
                </div>
                <pre><code>{project.preview.content}</code></pre>
                <p class="project-example__status" role="status"></p>
              </>
            ) : (
              <>
                <p class="project-example__label">{project.preview.label}</p>
                <dl class="project-evidence">
                  {project.preview.items.map((item) => (
                    <div><dt><code>{item.source}</code></dt><dd>{item.purpose}</dd></div>
                  ))}
                </dl>
              </>
            )}
          </div>
          <div class="project-row__links">
            {project.packageUrl && (
              <a href={project.packageUrl} aria-label={`${project.name} on PyPI`} target="_blank" rel="noreferrer">PyPI<span aria-hidden="true"> ↗</span></a>
            )}
            {project.homepage && (
              <a href={project.homepage} aria-label={`${project.name} Docs`} target="_blank" rel="noreferrer">Docs<span aria-hidden="true"> ↗</span></a>
            )}
            {project.corpusUrl && (
              <a href={project.corpusUrl} aria-label={`${project.name} on XERJ Hub`} target="_blank" rel="noreferrer">XERJ Hub<span aria-hidden="true"> ↗</span></a>
            )}
            <a href={project.url} aria-label={`${project.name} on GitHub`} target="_blank" rel="noreferrer">GitHub<span aria-hidden="true"> ↗</span></a>
          </div>
        </article>
      </li>
    ))}
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".project-example").forEach((example) => {
    const button = example.querySelector<HTMLButtonElement>(".project-example__copy");
    const code = example.querySelector<HTMLElement>("pre code");
    const status = example.querySelector<HTMLElement>(".project-example__status");
    if (!button || !code || !status) return;

    button.hidden = false;
    button.addEventListener("click", async () => {
      if (button.getAttribute("aria-disabled") === "true") return;
      if (!navigator.clipboard?.writeText) {
        status.textContent = "Copy unavailable. Select the code to copy it.";
        return;
      }
      button.setAttribute("aria-disabled", "true");
      button.setAttribute("aria-busy", "true");
      status.textContent = "Copying…";
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        status.textContent = "Code copied.";
      } catch {
        status.textContent = "Copy failed. Select the code to copy it.";
      } finally {
        button.removeAttribute("aria-disabled");
        button.removeAttribute("aria-busy");
      }
    });
  });
</script>
