---
import type { ResearchItem } from "../data/site";

interface Props {
  primary: ResearchItem;
  secondary: ResearchItem;
}

const { primary, secondary } = Astro.props;
---
<div class="research-layout">
  <article id={primary.id} class="research-primary">
    <header class="research-heading">
      <div>
        <p class="section-kicker">Primary research</p>
        <h3>{primary.title}</h3>
      </div>
      <div class="research-meta">
        <p>{primary.organization}</p>
        <p>{primary.time}</p>
      </div>
    </header>

    <p class="research-summary">{primary.summary}</p>
    <div class="research-details">
      <p class="research-question">{primary.question}</p>
      <p>{primary.contribution}</p>
    </div>
    <p class="method-line">{primary.methods.join(" · ")}</p>
    <div class="research-share">
      <a href={`#${primary.id}`} aria-label={`Link to ${primary.title}`}>Link to research</a>
      <button type="button" hidden aria-label={`Copy link to ${primary.title}`}>Copy link</button>
      <p role="status"></p>
    </div>
  </article>

  <article id={secondary.id} class="research-secondary">
    <header class="research-heading">
      <div>
        <p class="section-kicker">Related study</p>
        <h3>{secondary.title}</h3>
      </div>
      <div class="research-meta">
        <p>{secondary.organization}</p>
        <p>{secondary.time}</p>
      </div>
    </header>

    <p class="research-summary">{secondary.summary}</p>
    <div class="research-details">
      <p>{secondary.question}</p>
      <p>{secondary.contribution}</p>
    </div>
    <p class="method-line">{secondary.methods.join(" · ")}</p>
    <div class="research-share">
      <a href={`#${secondary.id}`} aria-label={`Link to ${secondary.title}`}>Link to research</a>
      <button type="button" hidden aria-label={`Copy link to ${secondary.title}`}>Copy link</button>
      <p role="status"></p>
    </div>
  </article>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".research-share").forEach((share) => {
    const link = share.querySelector<HTMLAnchorElement>("a")!;
    const button = share.querySelector<HTMLButtonElement>("button")!;
    const status = share.querySelector<HTMLElement>("[role=status]")!;
    button.hidden = false;
    button.addEventListener("click", async () => {
      if (button.getAttribute("aria-disabled") === "true") return;
      if (!navigator.clipboard?.writeText) {
        status.textContent = "Copy unavailable. Use the research link to copy it.";
        return;
      }
      button.setAttribute("aria-disabled", "true");
      button.setAttribute("aria-busy", "true");
      status.textContent = "Copying…";
      try {
        await navigator.clipboard.writeText(link.href);
        status.textContent = "Link copied.";
      } catch {
        status.textContent = "Copy failed. Use the research link to copy it.";
      } finally {
        button.removeAttribute("aria-disabled");
        button.removeAttribute("aria-busy");
      }
    });
  });
</script>
