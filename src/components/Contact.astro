---
interface Props {
  text: string;
  email: string;
  linkedin: string;
  github: string;
  resumePath: string;
}

const { text, email, linkedin, github, resumePath } = Astro.props;
---

<div class="contact-block">
  <p>{text}</p>
  <div class="contact-block__links">
    <a class="contact-block__email" href={`mailto:${email}`}>
      {email}
      <span aria-hidden="true"> ↗</span>
    </a>
    <a href={linkedin} target="_blank" rel="noreferrer">
      LinkedIn
    </a>
    <a href={github} target="_blank" rel="noreferrer">
      GitHub
    </a>
    <a href={resumePath}>Résumé</a>
  </div>
</div>
